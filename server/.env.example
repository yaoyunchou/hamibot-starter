# 本地服务端口
PORT=3000

# Cursor Python SDK（https://cursor.com/docs/sdk/python）
# API Key：Cursor Dashboard -> Integrations -> API Keys
CURSOR_API_KEY=your-cursor-api-key-here

# 模型（默认 composer-2.5，同一模型同时支持文本与截图分析）
CURSOR_MODEL=composer-2.5

# 本地 Agent 工作目录（留空则使用项目根目录）
# CURSOR_WORKSPACE=

# OCR 文字不足阈值（低于此数量时触发截图视觉分析，默认 3）
OCR_WEAK_THRESHOLD=3

# 默认任务描述（可被客户端覆盖）
DEFAULT_TASK=浏览当前页面，观察内容并汇报当前状态
